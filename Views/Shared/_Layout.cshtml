@using ProjKronos.Models

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] AGPW</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CliSenhas23.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&display=swap" rel="stylesheet">
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">

                <a class="navbar-brand letter-k"
                   asp-controller="Home"
                   asp-action="Index"
                   title="Início">
                    &alefsym;
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMain">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto">

                        <!-- DROPDOWN GESTÃO -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark"
                               href="#"
                               data-bs-toggle="dropdown">
                                Gestão
                            </a>

                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Clientes" asp-action="Index">Clientes</a></li>
                                <li><a class="dropdown-item" asp-controller="Funcionarios" asp-action="Index">Funcionários</a></li>
                                <li><a class="dropdown-item" asp-controller="Processos" asp-action="Index">Processos</a></li>
                                <li><a class="dropdown-item" asp-controller="LinhaProcessos" asp-action="Index">Linhas de Processos</a></li>
                                <li><a class="dropdown-item" asp-controller="Estados" asp-action="Index">Estados</a></li>
                                <li><a class="dropdown-item" asp-controller="Categorias" asp-action="Index">Categorias</a></li>
                            </ul>
                        </li>

                        <!-- DROPDOWN FILTROS -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-dark"
                               href="#"
                               data-bs-toggle="dropdown">
                                Filtros
                            </a>

                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="FiltrarProcessos"
                                       asp-action="Index">
                                        Filtrar Processos
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="ListItem"
                                       asp-action="Index">
                                        Listar Processos por Nome
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="FiltroLinhaProcesso"
                                       asp-action="Index">
                                        Listar Linhas de Processos por Filtro
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="FiltrarProcessos"
                                       asp-action="Index">
                                        Mostrar Processo por Filtro
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Login" asp-action="Index">Login</a>
                        </li>

                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted mt-4">
        <div class="container d-flex justify-content-between">
            <span style="color: rgba(0,0,0,0.25);">&copy; 2026 EFA01-25</span>
            <small style="color: rgba(0,0,0,0.25);">AGPW v1.0</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
