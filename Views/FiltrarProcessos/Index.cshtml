


<form asp-action="index" method="get">

    <table class="d-flex p-2" >

        <label>Cliente</label>
        <select name="idCliente" class="m-3">
            <option value="">--Selecione--</option>

            @foreach(var cliente in ViewBag.clientes)
                {
                    <option value="@cliente.Id">
                        @cliente.Id
                        @cliente.NomeCliente
                    </option>
                }

        </select>
        <label>Categorias</label>
        <select name="idCategoria" class="m-3">
            <option value="">--Selecione--</option>


            @foreach(var categoria in ViewBag.Categorias)
                {
                    <option value="@categoria.Id">
                        @categoria.Id
                        @categoria.Designacao
                    </option>
                }

        </select>
        <label>Prioridades</label>
        <select name="idPrioridade" class="m-3">
            <option value="">--Selecione--</option>

            @foreach (var prioridade in ViewBag.Prioridades)
                {
                <option value="@prioridade.Id">
                    @prioridade.Id
                    @prioridade.Designacao
                    </option>
                }

        </select>
        
        
        <button type="submit">Filtrar</button>
    </table>
</form>

<table class="table table-striped table-bordered table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Título</th>
            <th>Descrição</th>
            <th>Cliente</th>
            <th>Funcionário</th>
            <th>Data Criação</th>
            <th>Data Limite</th>
            <th>Coima</th>
            <th>Estado</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var processo in ViewBag.Processos)
        {
            <tr>
                <td>@processo.Id</td>
                <td>@processo.Titulo</td>
                <td>@processo.Descricao</td>
                <td>@processo.ClienteId</td>
                <td>@processo.FuncionarioId</td>
                <td>@processo.DataCriacao?.ToString("dd/MM/yyyy")</td>
                <td>@processo.DataLimite?.ToString("dd/MM/yyyy")</td>
                <td>@(processo.TemCoima ? "Sim" : "Não")</td>
                <td>@processo.Estado</td>
            </tr>
        }
    </tbody>
</table>